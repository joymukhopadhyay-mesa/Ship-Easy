{
  "name": "Non-divisible quantity (1,000 units at 12 per carton)",
  "today": "2026-10-25",
  "turns": [
    {
      "user": "I'm sending 1,000 ceramic mugs from London to a warehouse in Berlin, 12 per carton, £5 each",
      "expect": {
        "itemCartonsComputed": false,
