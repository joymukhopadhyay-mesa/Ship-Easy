          "options": [
            { "key": "a", "lines": [{ "quantity": 996, "cartons": 83, "unitsPerCarton": 12 }] },
            { "key": "b", "lines": [{ "quantity": 1008, "cartons": 84, "unitsPerCarton": 12 }] },
            { "key": "c", "lines": [{ "quantity": 996, "cartons": 83, "unitsPerCarton": 12 }, { "quantity": 4, "cartons": 1, "unitsPerCarton": 4 }] }
          ]
        },
        "invariant": "every option passes R-03"
      }
    },
    {
      "user": "b",
      "expect": { "items": [{ "quantity": 1008, "cartons": 84, "unitsPerCarton": 12 }], "rules": { "R-03": "pass" } }
    }
  ]
